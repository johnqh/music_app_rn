# Build-time configuration, inlined into the bundle by babel.config.js.
# Every name here is read by src/config/constants.ts or src/config/env.ts; a
# value left blank means "not configured", and whatever needs it is not
# offered rather than broken.
# Each variable says which platforms read it.
#
#   MUSIC_API_URL, MUSIC_WEB_URL, FIREBASE_PROXY,
#   VITE_*                             — every platform
#   APPLE_SERVICE_ID                   — Android
#   APPLE_REDIRECT_URI                 — Android
#   FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN,
#   FIREBASE_PROJECT_ID, FIREBASE_STORAGE_BUCKET,
#   FIREBASE_MESSAGING_SENDER_ID       — macOS, Windows
#   FIREBASE_APP_ID_MACOS,
#   FIREBASE_MEASUREMENT_ID_MACOS      — macOS
#   GA4_API_SECRET_MACOS               — macOS
#   GOOGLE_OAUTH_CLIENT_ID_MACOS       — macOS
#   FIREBASE_APP_ID_WINDOWS,
#   FIREBASE_MEASUREMENT_ID_WINDOWS    — Windows
#   GA4_API_SECRET_WINDOWS             — Windows
#   GOOGLE_OAUTH_CLIENT_ID_WINDOWS,
#   GOOGLE_OAUTH_CLIENT_SECRET_WINDOWS — Windows
#
# Firebase. iOS and Android are configured from their Google services files,
# ios/MoosiacRN/GoogleService-Info.plist and android/app/google-services.json,
# never from here: they are bundled with the app and safe in git, since each
# names the app's bundle ID and the native SDK checks the running app matches.
# Native Firebase (analytics, crashlytics, messaging, remote config) reads
# them, and auth, on Firebase's JS SDK so the China proxy covers it, is
# initialised from what native Firebase read. macOS and Windows are Firebase
# web apps, since Firebase has no desktop platform, and a web app's
# configuration has no bundle ID: they are configured by the FIREBASE_*
# variables below. FIREBASE_PROJECT_ID, FIREBASE_STORAGE_BUCKET and
# FIREBASE_MESSAGING_SENDER_ID are the project's; FIREBASE_API_KEY and
# FIREBASE_AUTH_DOMAIN are shared by its web apps; FIREBASE_APP_ID_* and
# FIREBASE_MEASUREMENT_ID_* are each desktop app's own (Firebase Console >
# Project settings > Your apps > the macOS or Windows web app).

# ---- Every platform ------------------------------------------------------

# The API this build talks to.
MUSIC_API_URL=http://localhost:8032

# Where the web app is served — what a shared link to a published score opens.
# Separate from the API because they are different hosts; the web dev
# server's port by default.
MUSIC_WEB_URL=http://localhost:5039

# Reverse proxy that keeps Firebase Auth, Remote Config and Analytics working
# for mainland-China users. Leave blank to use Firebase directly. It is a
# fetch wrapper (@sudobility/di), which is why this app runs Firebase's JS
# SDK for auth on every platform: the JS SDK's requests pass through it on a
# phone exactly as in a browser, and the native SDKs' never do. Not covered:
# native Google sign-in (Google's own login, which no proxy of ours can
# reach) and native Firebase itself — analytics, crashlytics, messaging and
# remote config reach Google directly on iOS and Android.
FIREBASE_PROXY=https://firebaseproxy.sudobility.com

# Branding (never hardcode the product name in components — src/config/constants.ts)
# Named VITE_*, same as music_app's and svgr_app_rn's — a bundler prefix that
# means nothing to Metro, kept anyway so one value name works across the
# whole family regardless of which app reads it.
VITE_APP_NAME=Moosiac
VITE_APP_DOMAIN=moosiac.com
VITE_COMPANY_NAME=Sudobility
VITE_SUPPORT_EMAIL=support@sudobility.com

# ---- Android -------------------------------------------------------------

# Sign in with Apple on Android, which is Apple's web flow: the Services ID
# and the redirect registered for it. Leave blank and the button is not
# shown. iOS needs neither — it needs the Sign in with Apple capability on
# the App ID.
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=

# ---- macOS and Windows ---------------------------------------------------

# Firebase, for the desktops' web apps. Shared across the project's web apps
# (Firebase Console > Project settings > Your apps > a web app's config):
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# ---- macOS ---------------------------------------------------------------

# Firebase, this desktop's own web app (Firebase Console > Project settings >
# Your apps > the macOS web app): its appId and Google Analytics
# measurementId.
FIREBASE_APP_ID_MACOS=
FIREBASE_MEASUREMENT_ID_MACOS=

# Google Analytics on macOS, sent through GA4's Measurement Protocol (a
# desktop is not a browser, so the JS SDK's analytics cannot run there): a
# Measurement Protocol API secret for the macOS data stream (Google Analytics
# > Admin > Data streams > the macOS stream > Measurement Protocol API
# secrets). Leave blank and macOS sends no analytics.
GA4_API_SECRET_MACOS=

# Google sign-in on macOS, through the system browser: the iOS app's own OAuth
# client, CLIENT_ID in ios/MoosiacRN/GoogleService-Info.plist. macOS is a
# Firebase web app, but Firebase accepts Google tokens from any client in the
# project, and only an iOS-type client lets a native app redirect to a URL
# scheme. Its reversed form is the URL scheme in ios/MoosiacRN/Info.plist and
# macos/MoosiacRN-macOS/Info.plist. iOS and Android take their Google
# clients from the services files. Leave blank and the button is not shown on
# macOS.
GOOGLE_OAUTH_CLIENT_ID_MACOS=

# ---- Windows -------------------------------------------------------------

# Firebase, this desktop's own web app (Firebase Console > Project settings >
# Your apps > the Windows web app): its appId and Google Analytics
# measurementId.
FIREBASE_APP_ID_WINDOWS=
FIREBASE_MEASUREMENT_ID_WINDOWS=

# Google Analytics on Windows, sent through GA4's Measurement Protocol (a
# desktop is not a browser, so the JS SDK's analytics cannot run there): a
# Measurement Protocol API secret for the Windows data stream (Google
# Analytics > Admin > Data streams > the Windows stream > Measurement Protocol
# API secrets). Leave blank and Windows sends no analytics.
GA4_API_SECRET_WINDOWS=

# Google sign-in on Windows: a "Desktop app" OAuth client (Google Cloud
# Console > Credentials > Create credentials > OAuth client ID > Desktop app)
# and its secret. Windows receives Google's redirect on a loopback address,
# which Google accepts only for that client type, and that type sends its
# secret with the token exchange — not confidential in an installed app, per
# Google. Leave the id blank and the button is not shown on Windows.
GOOGLE_OAUTH_CLIENT_ID_WINDOWS=
GOOGLE_OAUTH_CLIENT_SECRET_WINDOWS=
