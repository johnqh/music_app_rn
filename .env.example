# API URL
MUSIC_API_URL=http://localhost:8032

# Where the web app is served — what a shared link to a published score opens.
# Separate from the API because they are different hosts; the web dev
# server's port by default.
MUSIC_WEB_URL=http://localhost:5039

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Google sign-in on the desktop (macOS, Windows), through the system browser.
# From the Firebase project's iOS-type OAuth client in Google Cloud Console >
# Credentials: CLIENT_ID and REVERSED_CLIENT_ID in GoogleService-Info.plist.
# Leave blank and the button is not shown.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REVERSED_CLIENT_ID=

# Google sign-in on iOS and Android, through Google's own SDK. iOS signs in
# with the iOS-type client above, and its reversed form must also be a URL
# scheme in ios/MoosiacRN/Info.plist. Android needs the project's web-type
# client: the client_type 3 entry in android/app/google-services.json.
GOOGLE_WEB_CLIENT_ID=

# Sign in with Apple on Android, which is Apple's web flow: the Services ID
# and the redirect registered for it. iOS needs neither — it needs the Sign in
# with Apple capability on the App ID. Leave blank and Android shows no button.
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=

# Firebase China Proxy
# Reverse proxy that keeps Firebase Auth, Remote Config and Analytics working
# for mainland-China users. Leave blank to use Firebase directly.
# NOTE: covers the Firebase JS SDK only; @react-native-firebase native
# modules still reach Google directly.
FIREBASE_PROXY=https://firebaseproxy.sudobility.com

# Branding (never hardcode the product name in components — src/config/constants.ts)
# Named VITE_*, same as music_app's and svgr_app_rn's — a bundler prefix that
# means nothing to Metro, kept anyway so one value name works across the
# whole family regardless of which app reads it.
VITE_APP_NAME=Moosiac
VITE_APP_DOMAIN=moosiac.com
VITE_COMPANY_NAME=Sudobility
VITE_SUPPORT_EMAIL=support@sudobility.com
