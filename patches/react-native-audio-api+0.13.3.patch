@@ -11,6 +11,9 @@ $RN_AUDIO_API_STATIC_EXTERNAL_LIBS_DISABLED = ENV['DISABLE_AUDIOAPI_STATIC_EXTER
 fabric_flags = $new_arch_enabled ? '-DRCT_NEW_ARCH_ENABLED' : ''
 version_flag = "-DAUDIOAPI_VERSION=#{package_json['version']}"
 ios_min_version = '14.0'
+# AVAudioSourceNode is 10.15+; 11.0 is the first version react-native-macos
