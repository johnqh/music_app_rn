diff --git a/node_modules/react-native-audio-api/RNAudioAPI.podspec b/node_modules/react-native-audio-api/RNAudioAPI.podspec
index 85e28e4..487ebeb 100644
--- a/node_modules/react-native-audio-api/RNAudioAPI.podspec
+++ b/node_modules/react-native-audio-api/RNAudioAPI.podspec
@@ -11,6 +11,9 @@ $RN_AUDIO_API_STATIC_EXTERNAL_LIBS_DISABLED = ENV['DISABLE_AUDIOAPI_STATIC_EXTER
 fabric_flags = $new_arch_enabled ? '-DRCT_NEW_ARCH_ENABLED' : ''
 version_flag = "-DAUDIOAPI_VERSION=#{package_json['version']}"
 ios_min_version = '14.0'
+# AVAudioSourceNode is 10.15+; 11.0 is the first version react-native-macos
+# targets, so nothing is gained by going lower.
+osx_min_version = '11.0'
 
 worklets_enabled = $audio_api_config[:worklets_enabled]
 worklets_preprocessor_flag = worklets_enabled ? '-DRN_AUDIO_API_ENABLE_WORKLETS=1' : ''
@@ -28,7 +31,7 @@ Pod::Spec.new do |s|
   s.license      = package_json["license"]
   s.authors      = package_json["author"]
 
-  s.platforms    = { :ios => ios_min_version }
+  s.platforms    = { :ios => ios_min_version, :osx => osx_min_version }
   s.source       = { :git => "https://github.com/software-mansion/react-native-audio-api.git", :tag => "#{s.version}" }
 
   s.subspec "audioapi" do |ss|
@@ -38,7 +41,15 @@ Pod::Spec.new do |s|
     ss.header_mappings_dir = "common/cpp/audioapi"
 
     ss.subspec "ios" do |sss|
-      sss.source_files = "ios/audioapi/**/*.{mm,h,m,hpp}"
+      sss.ios.source_files = "ios/audioapi/**/*.{mm,h,m,hpp}"
+      # macOS builds every Apple source. Three of them are iOS-only concepts —
+      # the audio session, the now-playing notification, and the interruption
+      # observer — and each compiles to a no-op under TARGET_OS_OSX rather than
+      # being excluded. Excluding them was tried first and only moved the
+      # failure from the compiler to the linker: `AudioAPIModule` constructs a
+      # notification manager unconditionally, and `NotificationRegistry` builds
+      # a playback notification by name, so both classes have to exist.
+      sss.osx.source_files = "ios/audioapi/**/*.{mm,h,m,hpp}"
       sss.header_dir = "audioapi"
       sss.header_mappings_dir = "ios/audioapi"
     end
@@ -64,6 +75,9 @@ Pod::Spec.new do |s|
   end
 
   s.ios.frameworks = 'Accelerate', 'AVFoundation', 'MediaPlayer'
+  # No MediaPlayer: that framework carries the now-playing centre, which is the
+  # half deliberately not built here.
+  s.osx.frameworks = 'Accelerate', 'AVFoundation'
 
   s.prepare_command = <<-CMD
     chmod +x scripts/download-prebuilt-binaries.sh
