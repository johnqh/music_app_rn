+  s.platforms    = { :ios => ios_min_version, :osx => osx_min_version }
   s.source       = { :git => "https://github.com/software-mansion/react-native-audio-api.git", :tag => "#{s.version}" }
 
   s.subspec "audioapi" do |ss|
@@ -38,7 +41,15 @@ Pod::Spec.new do |s|
     ss.header_mappings_dir = "common/cpp/audioapi"
 
     ss.subspec "ios" do |sss|
-      sss.source_files = "ios/audioapi/**/*.{mm,h,m,hpp}"
+      sss.ios.source_files = "ios/audioapi/**/*.{mm,h,m,hpp}"
+      # macOS builds every Apple source. Three of them are iOS-only concepts —
+      # the audio session, the now-playing notification, and the interruption
+      # observer — and each compiles to a no-op under TARGET_OS_OSX rather than
+      # being excluded. Excluding them was tried first and only moved the
+      # failure from the compiler to the linker: `AudioAPIModule` constructs a
+      # notification manager unconditionally, and `NotificationRegistry` builds
+      # a playback notification by name, so both classes have to exist.
+      sss.osx.source_files = "ios/audioapi/**/*.{mm,h,m,hpp}"
       sss.header_dir = "audioapi"
