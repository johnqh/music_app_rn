+import * as React from 'react';
+import { View } from 'react-native';
+import type { NativeSafeAreaProviderProps } from './SafeArea.types';
+
+// A desktop client area has no cutout insets. Windows has no native provider;
+// report the view's frame so SafeAreaProvider can mount its children in modals.
+export function NativeSafeAreaProvider({
+  children,
+  style,
+  onInsetsChange,
+}: NativeSafeAreaProviderProps) {
+  return (
+    <View
+      style={style}
+      onLayout={event => {
+        onInsetsChange({
+          ...event,
+          nativeEvent: {
+            frame: event.nativeEvent.layout,
+            insets: { top: 0, right: 0, bottom: 0, left: 0 },
+          },
+        });
+      }}>
+      {children}
+    </View>
+  );
+}
