# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# ---- Prebuilt React Native artifacts --------------------------------------
#
# Downloads React Native's core and its C++ dependencies (Folly, glog, fmt,
# boost, double-conversion) as xcframeworks instead of compiling them. That is
# the single biggest build-time lever there is: React-Core alone is 231
# translation units and React-Fabric another 118, and this replaces the lot
# with an 18MB and a 79MB download that Meta has already built and tested.
#
# Read at `pod install` time, not build time, because they change which pods
# are declared. `||=` so an explicit value from the environment still wins.
#
# Verified present on Maven for react-native 0.81.6. Deliberately NOT set in
# `macos/Podfile`: react-native-macos publishes no such artifacts under its own
# version — both URLs 404 at 0.81.9 — so enabling it there only prints a
# fallback warning before building from source anyway.
ENV['RCT_USE_RN_DEP'] ||= '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1'

prepare_react_native_project!

# react-native-firebase 26 resolves Firebase through Swift Package Manager by
# default, which only works with dynamic pod linkage. This project cannot use
# dynamic linkage: React comes from the prebuilt core above, so pods built as
# dynamic frameworks fail to link, and CocoaPods rejects dynamic Firebase pods
# that depend on the static React pods. Keep Firebase on CocoaPods instead —
# it installs the same Firebase SDK version — and build every pod as a static
# framework, which is what Firebase's own pods require. Same arrangement as
# sudojo_app_rn.
$RNFirebaseDisableSPM = true

use_frameworks! :linkage => :static

target 'MoosiacRN' do
  config = use_native_modules!

  # Google Sign-In brings `AppCheckCore`, a Swift pod, and a Swift pod built
  # as a static library can only import what defines a module. These two do
  # not by default, and `pod install` refuses the whole install over it
  # ("cannot yet be integrated as static libraries"). Named one by one rather
  # than `use_modular_headers!` for everything, which changes how every other
  # pod here is built to fix two.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # fmt's format-string checks become `consteval` functions when the compiler
    # is new enough, and the version React Native pins then fails its own
    # constant evaluation under clang 21 / Xcode 26. Every error in the build is
    # in `fmt/format-inl.h` — none in this app, its patched audio dependency or
    # Skia.
    #
    # It has to be patched in the header rather than defined on the command
    # line: the chain that sets `FMT_USE_CONSTEVAL` begins with a plain `#if`
    # and no `#ifndef` guard, so the header redefines whatever the compiler was
    # told. Forcing the first branch true selects the `0` arm and puts those
    # functions back to ordinary `constexpr`, which is what every earlier
    # toolchain compiled. Remove when React Native ships a newer fmt.
    base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(base_h)
      text = File.read(base_h)
      needle = '#if !defined(__cpp_lib_is_constant_evaluated)'
      if text.include?(needle)
        # Pod sources land read-only, so the mode has to be relaxed first.
        File.chmod(0o644, base_h)
        File.write(base_h, text.sub(needle, '#if 1 // forced by Podfile: consteval is broken under clang 21'))
        Pod::UI.puts 'fmt: FMT_USE_CONSTEVAL forced off (clang 21 workaround)'
      end
    end
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Xcode 27 supports iOS deployment targets from 15.0 onward. Apply the
    # floor to every CocoaPods target, including generated privacy resources.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end

    # React Native Firebase imports React-Core's non-modular headers. With
    # static frameworks, Xcode rejects those imports from a module, so the
    # RNFB targets are built without module generation.
    installer.pods_project.targets.each do |target|
      next unless target.name.start_with?('RNFB')
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        config.build_settings['DEFINES_MODULE'] = 'NO'
      end
    end

    installer.target_installation_results.pod_target_installation_results
      .each do |_pod_name, target_installation_result|
      target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
        resource_bundle_target.build_configurations.each do |build_config|
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end

    # ---- Build-speed settings -------------------------------------------
    #
    # Xcode's DerivedData is the real cache and needs no configuration — it
    # only needs to be *used*, which means never passing `-derivedDataPath` to
    # a build. These three settings cut what a build has to do in the first
    # place, and none of them changes the produced binary's behaviour.
    #
    # No ccache, deliberately. Measured on a 1,192-file macOS build with the
    # launcher wired in: ccache saw 1,421 invocations and cached none of them.
    # 81.67% of uncacheable calls were "Could not use modules" — React Native
    # compiles with clang modules throughout, and only `sloppiness=modules`
    # makes those cacheable, which ccache disables by default because it can
    # serve an incorrect object file. Warm DerivedData and the prebuilt
    # artifacts do this job; a compiler wrapper on every invocation does not.
    # ---- Deployment target floor -----------------------------------------
    #
    # Xcode 27's iOS SDK **refuses** a deployment target below 15.0, and two of
    # the targets CocoaPods generates carry their pod's own historical minimum
    # rather than the Podfile's: `RNSVG-RNSVGFilters` at 12.4 and
    # `RNCAsyncStorage-RNCAsyncStorage_resources` at 13.4. Both are *resource
    # bundles*, which is why this was invisible until the SDK started refusing
    # them — and why it is a hard error rather than a warning:
    #
    #   error: The iOS Simulator deployment target 'IPHONEOS_DEPLOYMENT_TARGET'
    #   is set to 12.4, but the range of supported deployment target versions
    #   is 15.0 to 27.0.x. (in target 'RNSVG-RNSVGFilters' from project 'Pods')
    #
    # `react_native_post_install` raises the *pod* targets and leaves the
    # bundles alone, so this walks everything and lifts anything below the
    # project's own minimum. Raising a resource bundle changes nothing about
    # what is produced — a bundle has no code — so this is a floor rather than
    # a choice.
    minimum = min_ios_version_supported

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current.to_s) < Gem::Version.new(minimum.to_s)
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum
        end
        # The index store feeds Xcode's editor — symbol navigation and
        # autocomplete. A command-line build generates it and then throws it
        # away, so this is pure waste for `xcodebuild` and costs nothing real.
        config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
        next unless config.name == 'Debug'
        # One architecture instead of a universal binary, and no separate dSYM
        # bundle. Both only matter for distribution, which Debug is not.
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
      end
    end
  end
end
