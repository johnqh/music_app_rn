<Page
    x:Class="MoosiacRN.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoosiacRN"
    xmlns:react="using:Microsoft.ReactNative"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <!--
      The desktop Projects window's own page — a separate top-level window
      from MainPage.xaml's (see WindowManagerModule.cpp for how that window
      is created), not a screen inside it. Same shape as MainPage.xaml,
      down to reusing the same ReactNativeHost (WindowManagerModule wires
      that up, the same way MainPage.xaml.cpp does), with one difference:
      ComponentName names the Projects root (`src/app/ProjectsWindow.tsx`,
      registered in index.js) rather than the main app.
    -->
    <react:ReactRootView
        x:Name="ReactRootView"
        ComponentName="MoosiacProjects"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        MinHeight="400"/>
</Page>
