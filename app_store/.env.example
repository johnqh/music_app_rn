# App Store Submission Credentials
# Copy this file to .env and fill in your values.
#
# ── Apple App Store Connect API ─────────────────────────────────────────────
# Generate at: App Store Connect > Users and Access > Integrations > App Store Connect API
# Role: Admin (required for uploads and metadata updates)
#
# Key ID:    Shown in the API keys table (e.g., ABC1234DEF)
# Issuer ID: Shown at the top of the API keys page (e.g., 12345678-abcd-...)
# Key file:  Download the .p8 file and save to .keys/apple.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=

# ── Google Play Console ─────────────────────────────────────────────────────
# Create a service account at: Google Cloud Console > IAM & Admin > Service Accounts
# Grant it the "Service Account User" role, then in Google Play Console >
# Settings > API access, link the service account and grant "Release manager" permissions.
# Download the JSON key and save to .keys/google-play.json
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=.keys/google-play.json
